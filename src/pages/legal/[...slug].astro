---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate } from "@lib/utils"
import { SITE } from "@consts"

// Create the static pages for legal docs
export async function getStaticPaths() {
	const docs = await getCollection("legal")
	return docs.map((doc) => ({
		params: { slug: doc.slug },
		props: doc,
	}))
}

// Get the requested legal doc
type Props = CollectionEntry<"legal">;
const doc = Astro.props
const { title, date } = doc.data
const { Content } = await doc.render();

---

<PageLayout title={title} description={`${title} for ${SITE.TITLE}`}>
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading text-3xl font-semibold">
        {title}
      </h1>
      <p class="font-normal opacity-75">
        Last updated: {formatDate(date)}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate legal">
      <Content/>
    </article>
  </BottomLayout>
</PageLayout>

<style>
  /* Markdown output carries no Astro scope hash, so every child selector needs
     :global(). Tailwind's preflight zeroes heading and paragraph margins, which
     suits app chrome and makes a document unreadable, so set them back. */
  .legal :global(h2) {
    margin: 2rem 0 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    color: #000;
  }

  .legal :global(p) {
    margin: 1rem 0;
  }

  .legal :global(ul),
  .legal :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .legal :global(li) {
    margin: 0.35rem 0;
  }

  .legal :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .legal :global(a:hover) {
    color: #000;
  }

  html.dark .legal :global(h2),
  html.dark .legal :global(a:hover) {
    color: #fff;
  }
</style>