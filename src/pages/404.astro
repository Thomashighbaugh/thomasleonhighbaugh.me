---
import PageLayout from "@layouts/PageLayout.astro"
---

<PageLayout title="404" description="Page not found">
  <div class="flex flex-col items-center justify-center min-h-[50vh] gap-4 px-4">
    <h1 class="text-6xl font-bold text-black dark:text-white">404</h1>
    <p class="text-lg opacity-75">This page does not exist.</p>
    <a href="/" class="px-4 py-2 border rounded hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors">
      Go home
    </a>
  </div>
</PageLayout>
