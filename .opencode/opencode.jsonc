{
    "$schema": "https://opencode.ai/config.json",
    "extends": ["~/.config/opencode/opencode.jsonc"],
    "model": "ollama/deepseek-v4-flash:cloud",
    "default_agent": "hubs",
    "instructions": [
        "AGENTS.md",
        "./rules/*"
    ],
    "permission": {
        "edit": {
            "src/**": "allow",
            "public/**": "allow",
            ".github/**": "allow",
            "scripts/**": "allow",
            ".opencode/**": "allow"
        },
        "bash": "allow",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "question": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "lsp": "allow"
    }
}
